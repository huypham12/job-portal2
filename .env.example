# Job Portal Environment Configuration
# Copy this file to .env and configure your settings

# Application Settings
PORT=4000
HOST=http://localhost:4000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/job_portal_db?schema=recruitment"
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=job_portal_db
DB_SCHEMA=recruitment

# JWT Secrets (Generate strong random strings)
JWT_SECRET_ACCESS_TOKEN=your_very_strong_access_token_secret_here
JWT_SECRET_REFRESH_TOKEN=your_very_strong_refresh_token_secret_here
JWT_SECRET_EMAIL_VERIFY_TOKEN=your_very_strong_email_verify_secret_here
JWT_SECRET_FORGOT_PASSWORD_TOKEN=your_very_strong_forgot_password_secret_here
PASSWORD_SECRET=your_very_strong_password_secret_here

# Token Expiration Times
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
EMAIL_VERIFY_TOKEN_EXPIRES_IN=1d
FORGOT_PASSWORD_TOKEN_EXPIRES_IN=1h

# OAuth Google Configuration (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
CLIENT_REDIRECT_URI=http://localhost:3000/login/oauth

# AWS Configuration (Optional - for S3 file uploads and SES emails)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=job-portal-uploads
SES_FROM_ADDRESS=noreply@yourcompany.com

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password
ELASTICSEARCH_INDEX_PREFIX=job_portal
ELASTIC_ENABLE_SECURITY=false

# Email Service (Choose one)
# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key

# Or AWS SES (use AWS credentials above)

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png
