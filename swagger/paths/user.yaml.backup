# ================================
# PROFILE VISIBILITY ENDPOINT
# ================================

/user/me/profile/visibility:
  put:
    tags: [user]
    summary: Update profile visibility
    description: Update profile visibility (public/private)
    security: [{ bearerAuth: [] }]
    requestBody:
      required: true
      content:
        application/json:
          schema:
            type: object
            properties:
              is_public:
                type: boolean
                description: Whether profile is public
                example: true
    responses:
      '200': { description: Visibility updated }
      '400': { description: Validation error }
      '401': { description: Unauthorized }