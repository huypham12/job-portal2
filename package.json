{
  "name": "job-portal",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npx nodemon",
    "start": "node dist/src/app.js",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "build:scripts": "npm run build:setup-elasticsearch && npm run build:elasticsearch-cli && npm run build:bundle-swagger && npm run build:validate-es-mappings && npm run build:seeders",
    "build:setup-elasticsearch": "tsc scripts/setup-elasticsearch.ts --outDir dist/scripts/scripts --target ES2020 --module commonjs --esModuleInterop --skipLibCheck",
    "build:elasticsearch-cli": "tsc scripts/elasticsearch-cli.ts --outDir dist/scripts/scripts --target ES2020 --module commonjs --esModuleInterop --skipLibCheck",
    "build:bundle-swagger": "tsc scripts/bundle-swagger.ts --outDir dist/scripts/scripts --target ES2020 --module commonjs --esModuleInterop --skipLibCheck",
    "build:validate-es-mappings": "tsc scripts/validate-es-mappings.ts --outDir dist/scripts/scripts --target ES2020 --module commonjs --esModuleInterop --skipLibCheck",
    "build:seeders": "tsc prisma/seeders/seed.ts prisma/seeders/seed-admin.ts prisma/seeders/seed-candidate.ts prisma/seeders/seed-categories.ts prisma/seeders/seed-companies.ts prisma/seeders/seed-jobs.ts prisma/seeders/seed-locations.ts prisma/seeders/seed-skills.ts --outDir dist/scripts/prisma/seeders --target ES2020 --module commonjs --esModuleInterop --skipLibCheck",
    "test:unit": "tsx tests/unit/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "db:seed": "node dist/prisma/seeders/seed.js",
    "db:seed:batch": "cross-env CLEAR_EXISTING_DATA=true ENABLE_STREAMING=false node dist/prisma/seeders/seed.js",
    "db:seed:streaming": "cross-env CLEAR_EXISTING_DATA=true ENABLE_STREAMING=true node dist/prisma/seeders/seed.js",
    "db:seed:performance": "node dist/prisma/seeders/performance-test.js",
    "db:seed:validate": "node dist/prisma/seeders/validate-seed.js",
    "db:seed:comprehensive": "node dist/prisma/seeders/comprehensive-seed.js",
    "db:seed:test": "node dist/scripts/prisma/seeders/test-seed.js",
    "db:seed:cleanup": "node prisma/seeders/cleanup-deprecated.js",
    "db:seed:companies": "node dist/scripts/prisma/seeders/seed-companies.js",
    "db:seed:jobs": "node dist/scripts/prisma/seeders/seed-jobs.js",
    "db:seed:full": "npm run db:seed:streaming && npm run db:seed:validate",
    "dev:db:seed": "tsx prisma/seeders/seed.ts",
    "dev:db:seed:batch": "cross-env CLEAR_EXISTING_DATA=true ENABLE_STREAMING=false tsx prisma/seeders/seed.ts",
    "dev:db:seed:streaming": "cross-env CLEAR_EXISTING_DATA=true ENABLE_STREAMING=true tsx prisma/seeders/seed.ts",
    "dev:db:seed:companies": "tsx prisma/seeders/seed-companies.ts",
    "dev:db:seed:jobs": "tsx prisma/seeders/seed-jobs.ts",
    "dev:db:seed:full": "npm run dev:db:seed:streaming",
    "es:setup": "node dist/scripts/scripts/setup-elasticsearch.js",
    "es:setup:full": "node dist/scripts/scripts/setup-elasticsearch.js --migrate --seed",
    "es:setup:fresh": "node dist/scripts/scripts/setup-elasticsearch.js --reset",
    "es:init": "node dist/scripts/scripts/elasticsearch-cli.js init",
    "es:sync": "node dist/scripts/scripts/elasticsearch-cli.js sync",
    "es:health": "node dist/scripts/scripts/elasticsearch-cli.js health",
    "es:stats": "node dist/scripts/scripts/elasticsearch-cli.js stats",
    "es:reset": "node dist/scripts/scripts/elasticsearch-cli.js reset",
    "es:reset:deep": "node dist/scripts/scripts/elasticsearch-cli.js reset --deep",
    "dev:es:setup": "tsx scripts/setup-elasticsearch.ts",
    "dev:es:setup:full": "tsx scripts/setup-elasticsearch.ts --migrate --seed",
    "dev:es:setup:fresh": "tsx scripts/setup-elasticsearch.ts --reset",
    "dev:es:init": "tsx scripts/elasticsearch-cli.ts init",
    "dev:es:sync": "tsx scripts/elasticsearch-cli.ts sync",
    "dev:es:health": "tsx scripts/elasticsearch-cli.ts health",
    "dev:es:stats": "tsx scripts/elasticsearch-cli.ts stats",
    "dev:es:reset": "tsx scripts/elasticsearch-cli.ts reset",
    "dev:es:reset:deep": "tsx scripts/elasticsearch-cli.ts reset --deep",
    "cleanup:deprecated": "tsx scripts/cleanup-deprecated-endpoints.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
