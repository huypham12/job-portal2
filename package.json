{
  "name": "job-portal",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npx nodemon",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "es:setup": "tsx scripts/setup-elasticsearch.js",
    "es:setup:full": "tsx scripts/setup-elasticsearch.js --migrate --seed",
    "es:init": "tsx scripts/elasticsearch-cli.js init",
    "es:sync": "tsx scripts/elasticsearch-cli.js sync",
    "es:health": "tsx scripts/elasticsearch-cli.js health",
    "es:stats": "tsx scripts/elasticsearch-cli.js stats",
    "es:reset": "tsx scripts/elasticsearch-cli.js reset",
    "es:resync": "tsx scripts/manual-resync.ts",
    "test:unit": "tsx tests/unit/index.ts",
    "db:seed": "tsx prisma/seeders/seed.ts",
    "db:seed:batch": "CLEAR_EXISTING_DATA=true ENABLE_STREAMING=false tsx prisma/seeders/seed.ts",
    "db:seed:streaming": "CLEAR_EXISTING_DATA=true ENABLE_STREAMING=true tsx prisma/seeders/seed.ts",
    "db:seed:performance": "tsx prisma/seeders/performance-test.ts",
    "db:seed:validate": "tsx prisma/seeders/validate-seed.ts",
    "db:seed:comprehensive": "tsx prisma/seeders/comprehensive-seed.ts",
    "db:seed:test": "tsx prisma/seeders/test-seed.ts",
    "db:seed:cleanup": "node prisma/seeders/cleanup-deprecated.js",
    "db:seed:full": "npm run db:seed:streaming && npm run db:seed:validate"
  },
  "keywords": [],
